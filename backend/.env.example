PORT=5000
MONGO_URI=mongodb://localhost:27017/diet-planner
JWT_SECRET=your_jwt_secret_key_here
REFRESH_TOKEN_SECRET=your_refresh_secret_key_here
NODE_ENV=development

# Optional AI & External Providers
# Leave GEMINI_API_KEY blank to run the AI Coach on the built-in local nutrition engine.
# It answers macro reviews, meal ideas, food swaps, workout and hydration questions using
# the user's real profile and food log. Add a key to upgrade to live Gemini responses.
GEMINI_API_KEY=
# Optional: override the Gemini model used for chat and vision
GEMINI_MODEL=gemini-2.5-flash
CALORIENINJAS_API_KEY=
REDIS_URL=redis://127.0.0.1:6379
